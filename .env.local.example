# ==============================================================================
# POSTFLOW ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env.local`: `cp .env.local.example .env.local`
# 2. Fill in all REQUIRED values for local development and integration testing.
# 3. NEVER commit `.env.local` or any production secrets to Git.
# ==============================================================================

# ==============================================================================
# 1. SUPABASE (Database, Auth, Object Storage) - REQUIRED
# ==============================================================================
# Obtained from: https://supabase.com/dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Server-only Service Role Key (BYPASSES RLS):
# REQUIRED for Inngest background workers and administrative account deletion.
# SECURITY: NEVER prefix with NEXT_PUBLIC_ or import into client components.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ==============================================================================
# 2. TOKEN ENCRYPTION (AES-256-GCM) - REQUIRED
# ==============================================================================
# Used to encrypt OAuth access and refresh tokens at rest in PostgreSQL.
# MUST be exactly 64 hexadecimal characters (32 raw bytes).
# Generate a new random key with one of:
#   Node.js:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   OpenSSL:  openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ==============================================================================
# 3. TIKTOK DEVELOPER PORTAL (Content Posting API v2) - REQUIRED FOR TIKTOK
# ==============================================================================
# Obtained from: https://developers.tiktok.com/ -> Manage Apps -> App Details
# 
# Pre-requisites in TikTok Developer Portal:
# - Add "Content Posting API" and "Login Kit" products to your app.
# - Required Permissions (Scopes):
#     user.info.basic,video.publish
# - Add Redirect URI under Login Kit:
#     Local Dev:   http://localhost:3000/api/platforms/tiktok/callback
#     Production:  https://your-domain.com/api/platforms/tiktok/callback
#   (NOTE: Must match EXACTLY character-for-character)
TIKTOK_CLIENT_KEY=awxxxxxxxxxxxxxxxx
TIKTOK_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TIKTOK_REDIRECT_URI=http://localhost:3000/api/platforms/tiktok/callback

# ==============================================================================
# 4. INNGEST (Background Queue & Scheduler Engine) - REQUIRED FOR SCHEDULING
# ==============================================================================
# Local Development:
#   Run the Inngest Dev Server: `npx inngest-cli@latest dev -u http://localhost:3000/api/inngest`
#   In local dev mode, dummy keys work, or use keys from https://app.inngest.com
INNGEST_EVENT_KEY=inngest-event-key-local
INNGEST_SIGNING_KEY=signkey-prod-00000000000000000000000000000000

# ==============================================================================
# 5. SHOPEE AFFILIATE & OPEN PLATFORM (Optional)
# ==============================================================================
# Shopee Open Platform Partner keys (if using Seller APIs):
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REDIRECT_URI=http://localhost:3000/api/platforms/shopee/callback

# Shopee Affiliate Open API (GraphQL link tracking generation):
# Obtained from: https://affiliate.shopee.com/open_api
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_APP_SECRET=

# ==============================================================================
# 6. APPLICATION CONFIGURATION
# ==============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
